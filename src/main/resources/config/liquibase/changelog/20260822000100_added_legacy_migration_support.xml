<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260822000100-1" author="openai">
        <createTable tableName="migration_batch">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_version" type="varchar(32)"/>
            <column name="source_database" type="varchar(255)"/>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="${datetimeType}"/>
            <column name="tables_discovered" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tables_completed" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="rows_archived" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="text"/>
        </createTable>

        <createTable tableName="migration_table_result">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="source_table" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_rows" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="archived_rows" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="stale_rows" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="table_checksum" type="varchar(64)"/>
            <column name="started_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="${datetimeType}"/>
            <column name="error_message" type="text"/>
        </createTable>
        <addUniqueConstraint
            tableName="migration_table_result"
            columnNames="batch_id, source_table"
            constraintName="ux_migration_table_result__batch_table"/>
        <addForeignKeyConstraint
            baseTableName="migration_table_result"
            baseColumnNames="batch_id"
            referencedTableName="migration_batch"
            referencedColumnNames="id"
            constraintName="fk_migration_table_result__batch_id"
            onDelete="CASCADE"/>

        <createTable tableName="legacy_record_archive">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_table" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="source_primary_key" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="source_primary_key_hash" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="row_checksum" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="first_migration_batch_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen_batch_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="first_migrated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="last_migrated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="legacy_record_archive"
            columnNames="source_table, source_primary_key_hash"
            constraintName="ux_legacy_record_archive__table_pk"/>
        <createIndex tableName="legacy_record_archive" indexName="ix_legacy_record_archive__last_seen">
            <column name="source_table"/>
            <column name="last_seen_batch_id"/>
        </createIndex>

        <createTable tableName="migration_error">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="source_table" type="varchar(128)"/>
            <column name="source_primary_key" type="text"/>
            <column name="stage" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="error_type" type="varchar(255)"/>
            <column name="error_message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="text"/>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="migration_error"
            baseColumnNames="batch_id"
            referencedTableName="migration_batch"
            referencedColumnNames="id"
            constraintName="fk_migration_error__batch_id"
            onDelete="CASCADE"/>

        <createTable tableName="migration_id_map">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_table" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="source_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="target_table" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="migration_batch_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="mapped_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="migration_id_map"
            columnNames="source_table, source_id, target_table"
            constraintName="ux_migration_id_map__source_target"/>
    </changeSet>

    <changeSet id="20260822000100-2" author="openai">
        <addAutoIncrement tableName="migration_table_result" columnName="id" columnDataType="bigint"/>
        <addAutoIncrement tableName="legacy_record_archive" columnName="id" columnDataType="bigint"/>
        <addAutoIncrement tableName="migration_error" columnName="id" columnDataType="bigint"/>
        <addAutoIncrement tableName="migration_id_map" columnName="id" columnDataType="bigint"/>
    </changeSet>
</databaseChangeLog>
