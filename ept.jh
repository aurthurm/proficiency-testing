// ============================================================================
// ePT (Electronic Proficiency Testing) Domain Model
// JHipster 8.x – corrected configuration
// ============================================================================

application {
  config {
    baseName ept
    packageName zw.org.nmrl.ept
    applicationType monolith
    authenticationType jwt
    databaseType sql
    prodDatabaseType mysql
    devDatabaseType h2Disk
    cacheProvider no
    enableHibernateCache false
    buildTool maven
    clientFramework react
    testFrameworks [cypress]
    jhiPrefix jhi
    nativeLanguage en
    languages [en]
  }
}

enum Status { ACTIVE, INACTIVE, PENDING }
enum ShipmentStatus { DRAFT, PENDING, READY, QUEUED, PROCESSING, SHIPPED, EVALUATED, REPORTS_GENERATED, FINALIZED }
enum SchemeType { DTS, VL, EID, COVID19, TB, RECENCY, CUSTOM }
enum FinalResult { PASS, FAIL, EXCLUDED, NOT_EVALUATED }
enum ResponseStatus { NO_RESPONSE, RESPONDED, LATE, NOT_TESTED }
enum DataManagerType { MANAGER, PTCC }

entity DataManager {
  firstName String
  lastName String
  institute String
  primaryEmail String required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  secondaryEmail String pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  phone String
  mobile String
  language String
  status Status required
  dataManagerType DataManagerType required
  qcAccess Boolean
  viewOnlyAccess Boolean
  enableAddingTestResponseDate Boolean
  enableChoosingModeOfReceipt Boolean
  passwordResetToken String
  forcePasswordReset Boolean
  forceProfileCheck Boolean
  loginBan Boolean
  lastLogin Instant
  createdBy String
  createdOn Instant
  updatedBy String
  updatedOn Instant
}

entity Participant {
  uniqueIdentifier String required unique
  firstName String
  lastName String
  instituteName String required
  departmentName String
  email String required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  additionalEmail String
  address String
  shippingAddress String
  city String
  state String
  district String
  zip String
  country String
  region String
  phone String
  mobile String
  affiliation String required
  networkTier String
  siteType String
  fundingSource String
  testingVolume Long
  anc String
  pepfarId String
  lat Double
  lon Double
  labDirectorName String
  labDirectorEmail String
  contactPersonName String
  contactPersonEmail String
  contactPersonTelephone String
  individual String
  contactName String
  status Status required
  createdBy String
  createdOn Instant
  updatedBy String
  updatedOn Instant
  enrolledPrograms String
  customField1 String
  customField2 String
}

entity Scheme {
  schemeId String required unique
  schemeName String required
  status Status required
  isUserConfigured Boolean
  userTestConfig String
}

entity Distribution {
  distributionCode String required unique
  distributionDate LocalDate required
  status String required
  createdBy String
  createdOn Instant
  updatedBy String
  updatedOn Instant
}

entity Shipment {
  shipmentCode String required unique
  shipmentDate LocalDate required
  responseDeadline Instant required
  responseSwitch String
  autoCloseAtDeadline String
  allowEditingResponse String
  issuingAuthority String
  ptCoordinatorName String
  ptCoordinatorEmail String
  ptCoordinatorPhone String
  numberOfSamples Integer
  maxScore Integer
  reportGenerated String
  reportsGeneratedAt Instant
  finalizedAt Instant
  previousStatus String
  status ShipmentStatus required
  shipmentAttributes String
  schemeType SchemeType required
}

entity ShipmentParticipantMap {
  evaluationStatus String
  shipmentReceiptDate LocalDate
  shipmentTestDate LocalDate
  shipmentTestReportDate Instant
  responseStatus ResponseStatus
  isExcluded String
  isResponseLate String
  isPtTestNotPerformed String
  ptNotTestedReason String
  ptTestNotPerformedComments String
  ptSupportComments String
  supervisorApproval String
  participantSupervisor String
  userComment String
  labDirectorName String
  labDirectorEmail String
  contactPersonName String
  contactPersonEmail String
  contactPersonTelephone String
  modeId Integer
  synced String
  syncedOn Instant
  manualOverride String
  shipmentScore Double
  documentationScore Double
  finalResult FinalResult
  failureReason String
  optionalEvalComment String
  evaluationComment String
  isFollowup String
  qcDone String
  qcDate LocalDate
  qcDoneBy String
  qcCreatedOn Instant
  customField1 String
  customField2 String
  attributes String
  createdByAdmin Integer
  createdOnAdmin Instant
  updatedByUser Integer
  updatedOnUser Instant
  createdByUser Integer
  createdOnUser Instant
}

entity CorrectiveAction {
  correctiveAction String required
  description String
  actionTaken String
  actionDate LocalDate
  schemeType SchemeType required
}

entity ReferenceResult {
  sampleLabel String required
  samplePreparationDate LocalDate
  control Boolean
  mandatory Boolean
  sampleScore Double
  referenceResult String
  referenceResultDetails String
}

entity ResponseResult {
  reportedResult String
  additionalDetail String
  comments String
  calculatedScore Double
  responseDetails String
}

entity ReferenceResultVl {
  assay String
  value Double
}

entity ReportConfiguration {
  reportHeader String
  logo String
  logoRight String
  reportLayout String
  reportFormat String
  templateTopMargin Integer
  instituteAddressPosition String
}

entity CertificateTemplate {
  schemeType SchemeType required
  participationCertificate String
  excellenceCertificate String
  pDetectedFields String
  eDetectedFields String
}

entity CertificateBatch {
  batchName String required
  shipmentIds String required
  status String required
  excellenceCount Integer
  participationCount Integer
  skippedCount Integer
  downloadUrl String
  errorMessage String
  createdBy Integer
  createdOn Instant
  approvedBy Integer
  approvedOn Instant
}

entity ScheduledJob {
  job String required
  status String
  requestedOn Instant
  requestedBy Integer
  startedAt Instant
  lastHeartbeat Instant
  completedAt Instant
  progress Integer
  progressCompleted Integer
  progressTotal Integer
  summaryStatus String
}

entity EmailQueue {
  fromMail String
  fromFullName String
  replyTo String
  toEmail String required
  cc String
  bcc String
  subject String
  message String
  attachment String
  status String
  failureType String
  failureReason String
  queuedOn Instant
  sentAt Instant
}

entity AuditLog {
  statement String required
  type String
  createdBy String
  createdByRole String
  createdOn Instant required
  ipAddress String
  userAgent String
  sessionHash String
}

entity UserLoginHistory {
  userId Long
  loginContext String
  loginStatus String
  loginId String
  loginAttemptedDateTime Instant
  ipAddress String
  browser String
  operatingSystem String
  sessionHash String
}

entity ApiTracking {
  transactionId String required
  requestedBy Long
  requestedOn Instant
  numberOfRecords Integer
  requestType String
  testType String
  apiUrl String
  dataFormat String
}

entity HomePageConfiguration {
  section String
  type String
  link String
  sectionFile String
  text String
  icon String
  displayOrder Integer
  status String
}

entity Partner {
  partnerName String required
  link String
  logoImage String
  sortOrder Integer
  status String
  addedBy Integer
  addedOn Instant
}

relationship ManyToMany {
  DataManager{participants} to Participant{dataManagers}
}
relationship OneToMany {
  Distribution{shipments} to Shipment{distribution}
}
relationship OneToMany {
  Shipment{participantMaps} to ShipmentParticipantMap{shipment}
}
relationship OneToMany {
  Participant{shipmentMaps} to ShipmentParticipantMap{participant}
}
relationship OneToMany {
  Shipment{referenceResults} to ReferenceResult{shipment}
}
relationship OneToOne {
  ShipmentParticipantMap{responseResult} to ResponseResult{shipmentParticipantMap}
}
relationship OneToMany {
  Scheme{correctiveActions} to CorrectiveAction{scheme}
}
relationship OneToOne {
  Scheme{certificateTemplate} to CertificateTemplate{scheme}
}
relationship OneToMany {
  Scheme{shipments} to Shipment{scheme}
}
relationship OneToOne {
  DataManager{user} to User with builtInEntity
}

paginate DataManager, Participant, Distribution, Shipment, ShipmentParticipantMap with pagination
paginate AuditLog, UserLoginHistory, ApiTracking, CertificateBatch, ScheduledJob, EmailQueue with pagination

dto * with mapstruct
service all with serviceImpl
